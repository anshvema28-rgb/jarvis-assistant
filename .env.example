# ------------------------------------------------------------
# Copy this file to ".env" and fill in the values you want.
# The .env file is read ONLY by server.js - never by the browser.
# It is listed in .gitignore, so it is never committed to git.
# Leave GEMINI_API_KEY empty to run in offline mode (works instantly).
# ------------------------------------------------------------

# Port for the local web server
PORT=3000

# --- Google Gemini (free tier available) ---
# Get a key at https://aistudio.google.com/apikey
# The key stays on the server and is never sent to the browser.
# IMPORTANT: the variable names must be exactly these. Old names
# AI_API_KEY / AI_API_URL / AI_MODEL are no longer read by server.js.
# Paste the key with no spaces and no quote marks (starts with AIza).
GEMINI_API_KEY=
# Recommended: gemini-flash-lite-latest (free tier, always the newest
# flash-lite model). NOTE: gemini-2.5-flash returns 404 for new accounts,
# and the bigger flash models often hit "high demand" (503).
# If your model fails, server.js automatically retries with the default.
GEMINI_MODEL=gemini-flash-lite-latest
